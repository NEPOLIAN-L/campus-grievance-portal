<%- include("../partials/header") %>

<h1>Reports &amp; Analytics</h1>

<div class="stat-grid">
  <div class="stat-box"><div class="num"><%= stats.total %></div><div class="label">Total Grievances</div></div>
  <div class="stat-box"><div class="num"><%= stats.byStatus["Resolved"] || 0 %></div><div class="label">Resolved</div></div>
  <div class="stat-box"><div class="num"><%= stats.byStatus["Pending"] || 0 %></div><div class="label">Pending</div></div>
  <div class="stat-box"><div class="num"><%= stats.avgResolutionHours !== null ? stats.avgResolutionHours + "h" : "—" %></div><div class="label">Avg. Resolution Time</div></div>
</div>

<div class="card">
  <h3>By Status</h3>
  <% Object.entries(stats.byStatus).forEach(([k, v]) => { %>
    <div class="bar-row">
      <div class="bar-label"><%= k %></div>
      <div class="bar-track"><div class="bar-fill" style="width:<%= stats.total ? Math.round((v/stats.total)*100) : 0 %>%"></div></div>
      <div><%= v %></div>
    </div>
  <% }) %>
</div>

<div class="card">
  <h3>By Category</h3>
  <% Object.entries(stats.byCategory).forEach(([k, v]) => { %>
    <div class="bar-row">
      <div class="bar-label"><%= k %></div>
      <div class="bar-track"><div class="bar-fill" style="width:<%= stats.total ? Math.round((v/stats.total)*100) : 0 %>%"></div></div>
      <div><%= v %></div>
    </div>
  <% }) %>
</div>

<%- include("../partials/footer") %>
