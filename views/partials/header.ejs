<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= title %><%= title !== "Campus Grievance Portal" ? " | Campus Grievance Portal" : "" %></title>
  <link href="https://fonts.googleapis.com/css?family=Source+Sans+Pro:300,400,600,700" rel="stylesheet" />
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css" rel="stylesheet" />
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body class="skin-green layout-top-nav">
<div class="wrapper">

  <header class="main-header">
    <nav class="navbar">
      <div class="container-fluid navbar-inner">
        <div class="navbar-header">
          <a href="/" class="navbar-brand"><b>CGP</b></a>
          <button type="button" id="toggleMenuBtn" class="navbar-toggle" aria-label="Toggle menu">
            <i class="fa fa-bars"></i>
          </button>
        </div>

        <div class="navbar-collapse" id="navbar-collapse">
          <ul class="nav navbar-nav">
            <% if (currentUser) { %>
              <% if (currentUser.role === "student") { %>
                <li class="dropdown">
                  <a href="#" class="dropdown-toggle">Grievance <span class="caret"></span></a>
                  <ul class="dropdown-menu">
                    <li><a href="/dashboard">My Grievances</a></li>
                    <li><a href="/grievance/new">Submit Grievance</a></li>
                  </ul>
                </li>
              <% } else { %>
                <li><a href="/admin">Dashboard</a></li>
                <li><a href="/admin/reports">Reports</a></li>
              <% } %>
              <li><a href="/notifications"><i class="fa fa-bell-o"></i> Notifications</a></li>
            <% } else { %>
              <li><a href="/login">Login</a></li>
              <li><a href="/register">Register</a></li>
            <% } %>
          </ul>

          <ul class="nav navbar-nav navbar-right">
            <li class="nav-clock"><span id="clock-time"></span><br /><span id="clock-date"></span></li>
            <% if (currentUser) { %>
              <li class="dropdown user-menu">
                <a href="#" class="dropdown-toggle">
                  <span class="user-image"><i class="fa fa-user"></i></span>
                  <span class="hidden-xs"><%= currentUser.name %></span> <span class="caret"></span>
                </a>
                <ul class="dropdown-menu dropdown-menu-right">
                  <li class="user-role"><%= currentUser.role === "admin" ? "Administrator" : "Student" %></li>
                  <li class="divider"></li>
                  <li><a href="/logout">Sign Out</a></li>
                </ul>
              </li>
            <% } %>
          </ul>
        </div>
      </div>
    </nav>
  </header>

  <div class="top-strip"></div>

  <div class="content-wrapper">
    <section class="content">
      <% if (flash) { %>
        <div class="flash <%= flash.type %>"><%= flash.text %></div>
      <% } %>
